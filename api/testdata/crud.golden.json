  "openapi": "3.1.0",
  "paths": {
    "/order-items": {
      "get": {
        "operationId": "listOrderItems",
        "parameters": [
          {
            "description": "Page size.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Comma-separated fields, '-' for descending, e.g. -net. Sortable: sku, qty, net.",
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Case-insensitive substring match. Repeat to match any of several values. Operators: sku[eq], sku[ne], sku[contains], sku[in]. sku[in] takes a comma-separated list.",
            "in": "query",
            "name": "sku",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Exact match. Repeat to match any of several values. Operators: qty[eq], qty[ne], qty[gt], qty[gte], qty[lt], qty[lte], qty[in]. qty[in] takes a comma-separated list.",
            "in": "query",
            "name": "qty",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Exact match. Repeat to match any of several values. Operators: net[eq], net[ne], net[gt], net[gte], net[lt], net[lte], net[in]. net[in] takes a comma-separated list.",
            "in": "query",
            "name": "net",
            "schema": {
              "format": "double",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrderItem"
                  },
                  "type": "array"
                }
              }
            },
            "description": "A page of order-items.",
            "headers": {
              "Link": {
                "description": "RFC 8288 links to the first, prev, next and last pages.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of records matching the filters, across all pages.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "List order-items",
        "tags": [
          "order-items"
        ]
      },
      "post": {
        "operationId": "createOrderItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderItemInput"
              }
            }
          },
          "required": true
        },
