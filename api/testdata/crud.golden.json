{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Invalid filter, paging parameter or JSON body. invalid_fields names the offending parameters."
      },
      "Conflict": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "A record with this key already exists."
      },
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Not allowed to perform this operation."
      },
      "InternalServerError": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Something failed on the server. Details are logged, not returned."
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "No record has this id."
      },
      "PayloadTooLarge": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request body is larger than the server allows."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Missing or invalid credentials."
      },
      "UnprocessableEntity": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The body failed validation; detail explains why."
      }
    },
    "schemas": {
      "OrderItem": {
        "properties": {
          "net": {
            "format": "double",
            "type": "number"
          },
          "qty": {
            "format": "int64",
            "type": "integer"
          },
          "sku": {
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "sku",
          "qty",
          "net"
        ],
        "type": "object"
      },
      "OrderItemInput": {
        "properties": {
          "net": {
            "format": "double",
            "type": "number"
          },
          "qty": {
            "format": "int64",
            "type": "integer"
          },
          "sku": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation problems (422).",
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "invalid_fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Omitted means about:blank.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "type": "object"
      },
      "Todo": {
        "properties": {
          "attachment": {},
          "done": {
            "type": "boolean"
          },
          "due": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "meta": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "owner": {
            "$ref": "#/components/schemas/User"
          },
          "priority": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "reviewer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "done",
          "priority",
          "tags",
          "meta",
          "owner",
          "reviewer",
          "attachment"
        ],
        "type": "object"
      },
      "TodoInput": {
        "properties": {
          "attachment": {},
          "done": {
            "type": "boolean"
          },
          "due": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "owner": {
            "$ref": "#/components/schemas/User"
          },
          "priority": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "reviewer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/User"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Golden test",
    "title": "Shop",
    "version": "2.1.0"
