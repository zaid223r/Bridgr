{
  "name": "bridgr-todos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "go run ../server -spec openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
