{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Invalid filter, paging parameter or JSON body. invalid_fields names the offending parameters."
      },
      "Conflict": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "A record with this key already exists."
      },
      "Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Not allowed to perform this operation."
      },
      "InternalServerError": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Something failed on the server. Details are logged, not returned."
      },
      "NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "No record has this id."
      },
      "PayloadTooLarge": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The request body is larger than the server allows."
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Missing or invalid credentials."
      },
      "UnprocessableEntity": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "The body failed validation; detail explains why."
      }
    },
    "schemas": {
      "Problem": {
        "description": "RFC 9457 problem details.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "Field-level validation problems (422).",
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "invalid_fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "request_id": {
            "description": "The X-Request-ID of the request, for support.",
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Omitted means about:blank.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "type": "object"
      },
      "Todo": {
        "properties": {
          "done": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "priority": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "done",
          "priority"
        ],
        "type": "object"
      },
      "TodoInput": {
        "properties": {
          "done": {
            "type": "boolean"
          },
          "priority": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Todo API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/todos": {
      "get": {
        "operationId": "listTodos",
        "parameters": [
          {
            "description": "Page size.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Number of records to skip.",
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Comma-separated fields, '-' for descending, e.g. -priority. Sortable: id, title, done, priority.",
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Case-insensitive substring match. Repeat to match any of several values. Operators: title[eq], title[ne], title[contains], title[in]. title[in] takes a comma-separated list.",
            "in": "query",
            "name": "title",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Exact match. Repeat to match any of several values. Operators: done[eq], done[ne].",
            "in": "query",
            "name": "done",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Exact match. Repeat to match any of several values. Operators: priority[eq], priority[ne], priority[gt], priority[gte], priority[lt], priority[lte], priority[in]. priority[in] takes a comma-separated list.",
            "in": "query",
            "name": "priority",
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "A page of todos.",
            "headers": {
              "Link": {
                "description": "RFC 8288 links to the first, prev, next and last pages.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Number of records matching the filters, across all pages.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "List todos",
        "tags": [
          "todos"
        ]
      },
      "post": {
        "operationId": "createTodo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The created record."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Create a Todo",
        "tags": [
          "todos"
        ]
      }
    },
    "/todos/{id}": {
      "delete": {
        "operationId": "deleteTodo",
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Delete a Todo",
        "tags": [
          "todos"
        ]
      },
      "get": {
        "operationId": "getTodo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The record."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Get a Todo",
        "tags": [
          "todos"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "format": "int64",
            "type": "integer"
          }
        }
      ],
      "patch": {
        "operationId": "updateTodo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The stored record."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Update the fields of a Todo present in the body",
        "tags": [
          "todos"
        ]
      },
      "put": {
        "operationId": "replaceTodo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TodoInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            },
            "description": "The stored record."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "summary": "Replace a Todo; fields missing from the body are reset",
        "tags": [
          "todos"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "todos"
    }
  ]
}
